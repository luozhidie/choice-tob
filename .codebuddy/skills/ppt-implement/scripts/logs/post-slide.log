       user: { email, role: 'admin' } \n          }));\n        } else {\n          res.statusCode = 401;\n          res.setHeader('Content-Type', 'application/json');\n          res.end(JSON.stringify({ error: '邮箱或密码错误' }));\n        }\n      } catch (e) {\n        res.statusCode = 500;\n        res.setHeader('Content-Type', 'application/json');\n        res.end(JSON.stringify({ error: '服务器错误' }));\n      }\n    });\n    return;\n  }\n  \n  // 404 for other API routes\n  res.statusCode = 404;\n  res.setHeader('Content-Type', 'application/json');\n  res.end(JSON.stringify({ error: 'API endpoint not found' }));\n}\n"},"tool_response":"Successfully created and wrote to new file: /workspace/api/index.ts","call_id":"chatcmpl-tool-87c326ce32960602","tool_use_id":"chatcmpl-tool-87c326ce32960602","permission_mode":"dontAsk","client":"CLI","version":"2.94.3","generation_id":"cae27962abb34d59b549b1b67ed0ceef","model":"hy3-preview-agent"}
