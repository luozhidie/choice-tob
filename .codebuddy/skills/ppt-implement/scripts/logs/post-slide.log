n>\n        </Link>\n      </div>\n\n      {/* 菜单 */}\n      <nav className=\"flex-1 p-3 space-y-1 overflow-y-auto\">\n        {menuItems.map((item) => {\n          const isActive = location.pathname === item.path;\n          const Icon = item.icon;\n          return (\n            <Link\n              key={item.path}\n              to={item.path}\n              className=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium no-underline transition-colors\"\n              style={{\n                background: isActive ? 'oklch(1 0 0 / 0.1)' : 'transparent',\n                color: isActive ? 'oklch(0.85 0.15 295)' : 'oklch(0.6 0.03 295)',\n              }}\n            >\n              <Icon size={18} />\n              {item.label}\n            </Link>\n          );\n        })}\n      </nav>\n\n      {/* 退出 */}\n      <div className=\"p-3 border-t\" style={{ borderColor: 'oklch(1 0 0 / 0.1)' }}>\n        <button\n          onClick={handleLogout}\n          className=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium w-full no-underline\"\n          style={{ color: 'oklch(0.5 0.03 295)' }}\n        >\n          <LogOut size={18} />\n          退出登录\n        </button>\n      </div>\n    </aside>\n  );\n}\n","file_path":"/workspace/frontend/src/components/admin/Sidebar.tsx"},"tool_response":"Successfully created and wrote to new file: /workspace/frontend/src/components/admin/Sidebar.tsx","call_id":"chatcmpl-tool-a6bb7989bf654196","tool_use_id":"chatcmpl-tool-a6bb7989bf654196","permission_mode":"dontAsk","client":"CLI","version":"2.94.3","generation_id":"8bede719cbd74dd788c14f43be9b34de","model":"hy3-preview-agent"}
